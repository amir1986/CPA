# ──────────────────────────────────────────────────────────────────────
# api
# ──────────────────────────────────────────────────────────────────────

# Ollama Cloud keys (newline- or comma-separated, or use OLLAMA_API_KEYS_FILE)
OLLAMA_API_KEYS=
# OLLAMA_API_KEYS_FILE=/run/secrets/ollama_keys
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=qwen3.5:397b-cloud

# KeyRotator tuning
OLLAMA_RATE_LIMIT_COOLDOWN_SECONDS=60
OLLAMA_MAX_RETRIES_PER_KEY=2
OLLAMA_REQUEST_TIMEOUT_SECONDS=120

# Database
DATABASE_URL=postgresql+asyncpg://cpa:cpa@postgres:5432/cpa

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# Object storage (MinIO-compatible)
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=cpa
S3_SECRET_KEY=cpa-secret
S3_BUCKET=cpa
S3_REGION=us-east-1

# Embeddings
EMBED_MODEL=intfloat/multilingual-e5-large
EMBED_DEVICE=cpu

# Auth (api)
JWT_SECRET=change-me-32-bytes-base64
JWT_ACCESS_TTL_SECONDS=1800
JWT_REFRESH_TTL_SECONDS=2592000
ADMIN_API_KEY=change-me-admin-key

# SMTP (dev: MailHog)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=cpa@example.com
SMTP_STARTTLS=false

# Retrieval
RETRIEVAL_TOP_K=8
RETRIEVAL_MIN_SCORE=0.25
RETRIEVAL_LANG_STRICT_HE=true

# Telemetry
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=INFO

# ──────────────────────────────────────────────────────────────────────
# web
# ──────────────────────────────────────────────────────────────────────

AUTH_SECRET=change-me-32-bytes-base64
AUTH_URL=http://localhost:8080
AUTH_TRUST_HOST=true
INTERNAL_API_BASE=http://api:8000
NEXT_PUBLIC_API_BASE=/api
NEXT_PUBLIC_DEFAULT_LOCALE=en
