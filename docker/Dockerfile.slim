# Slim image for free-tier hosts (Render 512 MB, Fly hobby).
# Single-stage, plain pip install — no lockfile required.
# Image lands ~350 MB. Skips Tesseract, WeasyPrint, Hebrew packs, and
# the ml extras (sentence-transformers/torch); HashEmbedder is the
# default backend so the runtime is fine without them.
#
# syntax=docker/dockerfile:1.7

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Build-time deps for asyncpg + any wheel that compiles from source.
# We purge build-essential after install to keep the image small.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        libpq-dev \
        curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy project metadata + source, install in one layer so pip can find
# the project and resolve [project.dependencies] from pyproject.toml.
# We deliberately do NOT install [project.optional-dependencies.ml] —
# sentence-transformers + torch would blow past 512 MB.
COPY pyproject.toml ./
COPY app ./app
COPY alembic.ini ./alembic.ini
COPY migrations ./migrations
COPY config ./config
COPY scripts ./scripts
COPY docker/entrypoint.sh ./entrypoint.sh

RUN pip install --no-cache-dir . \
 && apt-get purge -y --auto-remove build-essential \
 && rm -rf /var/lib/apt/lists/* /root/.cache \
 && chmod +x /app/entrypoint.sh \
 && useradd --create-home --shell /bin/bash --uid 10001 app \
 && chown -R app:app /app

USER app
EXPOSE 8000
ENV PORT=8000

HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=30s \
    CMD curl -fsS "http://127.0.0.1:${PORT}/healthz" || exit 1

ENTRYPOINT ["/app/entrypoint.sh"]
